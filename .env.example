# Copy to .env and fill in. Defaults avoid the common 3000/8000 ports.
WEB_PORT=3100
API_PORT=8008

# The URL the BROWSER uses to reach the API (baked into the web bundle at build time).
PUBLIC_API_URL=http://localhost:8008/api/v1
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# REQUIRED - compose refuses to start without these. Generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
POSTGRES_PASSWORD=
POSTGRES_USER=careflow
POSTGRES_DB=careflow

# production = fail-closed (strong secret required, demo features refused).
# For a local demo only: APP_ENV=development, SEED_ON_STARTUP=true, DEMO_MODE=true
APP_ENV=production
SEED_ON_STARTUP=false
DEMO_MODE=false
DEMO_PASSWORD=careflow
