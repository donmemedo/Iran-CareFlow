# Copy to .env and adjust. Defaults avoid the common 3000/8000 ports.
WEB_PORT=3100
API_PORT=8008

# The URL the BROWSER uses to reach the API (baked into the web bundle at build
# time). Must match API_PORT above, or your public domain in production.
PUBLIC_API_URL=http://localhost:8008/api/v1
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

POSTGRES_USER=careflow
POSTGRES_PASSWORD=careflow
POSTGRES_DB=careflow

# CHANGE THIS before any deployment that is reachable by others.
JWT_SECRET=change-me-in-production
SEED_ON_STARTUP=true
