# Backend configuration (copy to .env). Nothing here is a working secret.
APP_ENV=development                 # development | production (production refuses weak/demo settings)
DATABASE_URL=sqlite:///./careflow.db
# Required in production, >= 32 random characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# In development an empty value mints an ephemeral secret per process.
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_TOKEN_TTL_MINUTES=60
# Demo data and the persona picker. Must stay false in production.
SEED_ON_STARTUP=false
DEMO_MODE=false
# Set true only when running behind a proxy you control (it trusts X-Forwarded-For for rate limiting).
TRUST_PROXY_HEADERS=false
